! HENDOS benchmark initial conditions: Plummer sphere, 1000 stars from the Maschberger IMF, half-mass radius 1 pc
! made by run_benchmarks.sh with   ./makeics ../benchmark/ics/plummer_imf_1k.nml
! (the script changes seed and outfile for each seed it runs)
&ics
  outfile = 'data/bench_plummer_imf_1k.dat'
  n       = 1000
  seed    = 12345
  distribution = 'plummer'
  radius  = 1.0
  qvir    = 0.5
/
&fractal
  fdim = 1.6
  velocities = 'standard'
/
&masses
  imf = 'maschberger'
  mequal = 1.0
/
